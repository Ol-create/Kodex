# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database (Postgres 16 + pgvector) ---
# Local dev: WSL cluster created by `npm run db:setup:wsl`
DATABASE_URL="postgresql://rag:rag_dev_password@localhost:5433/rag"

# --- Embeddings ---
# The Chunk.embedding column is vector(1024). Changing the dimension needs a migration.
EMBEDDING_DIMENSIONS=1024
EMBEDDING_PROVIDER=voyage          # voyage | ollama
# EMBEDDING_MODEL=                 # default: voyage-3.5 (voyage) / mxbai-embed-large (ollama)
VOYAGE_API_KEY=                    # https://dash.voyageai.com/
# OLLAMA_BASE_URL=http://localhost:11434

# --- Generation ---
LLM_PROVIDER=openai                # openai | anthropic
OPENAI_API_KEY=                    # https://platform.openai.com/api-keys
# ANTHROPIC_API_KEY=               # when LLM_PROVIDER=anthropic (or use `ant auth login`)
# LLM_MODEL=                       # default: gpt-5.4-mini (openai) / claude-opus-5-5 (anthropic)
LLM_EFFORT=medium                  # low | medium | high | xhigh | max (reasoning models only)
