{
  "name": "kodex",
  "version": "0.1.0",
  "description": "Kodex: multi-tenant retrieval-augmented generation (RAG) service (Express + Postgres/pgvector).",
  "main": "src/server.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "db:setup:wsl": "wsl -d Ubuntu -u root bash scripts/setup-wsl-db.sh",
    "db:up": "wsl -d Ubuntu --exec sleep infinity",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "apikey:create": "node scripts/create-api-key.js",
    "ingest": "node scripts/ingest.js",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@prisma/config": "^7.10.1",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1"
  }
}
