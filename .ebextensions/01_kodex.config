# Elastic Beanstalk (Node.js platform). Secrets (DATABASE_URL, VOYAGE_API_KEY,
# OPENAI_API_KEY) are set as environment properties in the console or with
# `eb setenv`, never here.
option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    LOG_FORMAT: json
    TRUST_PROXY: "1"
  aws:elasticbeanstalk:application:
    # Healthy only when Postgres and pgvector are reachable.
    Application Healthcheck URL: /health/ready

container_commands:
  # Apply pending migrations once per deploy (on one instance), before the new
  # version starts taking traffic. A failed migration fails the deploy.
  01_migrate:
    command: "npx prisma migrate deploy"
    leader_only: true
